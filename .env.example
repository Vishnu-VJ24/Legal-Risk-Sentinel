# Runtime / hosting
HOST=0.0.0.0
PORT=7860
APP_DATA_DIR=/tmp/legal-sentinel-data
MAX_UPLOAD_MB=25
RUN_TTL_HOURS=24

# Provider secret
NVIDIA_API_KEY=replace-me-in-your-local-env-or-hf-secrets
# Optional comma-separated pool. When set, it takes precedence over NVIDIA_API_KEY.
NVIDIA_API_KEYS=
OCR_SPACE_API_KEY=replace-me-in-your-local-env-or-hf-secrets

# Model selection
LLM_PROVIDER=nvidia
LLM_MODEL=openai/gpt-oss-20b
# Per-stage provider/model variables override the defaults above when needed.
# EDGE_VERIFY_PROVIDER=nvidia
# EDGE_VERIFY_MODEL=openai/gpt-oss-20b
# CLAUSE_REPAIR_PROVIDER=nvidia
# CLAUSE_REPAIR_MODEL=openai/gpt-oss-20b
# RISK_ANALYZER_PROVIDER=nvidia
# RISK_ANALYZER_MODEL=openai/gpt-oss-20b
# FINAL_REPORT_PROVIDER=nvidia
# FINAL_REPORT_MODEL=openai/gpt-oss-20b

# OCR is fallback-only and is invoked when embedded text is below this threshold.
OCR_ENABLED=true
OCR_MIN_TEXT_CHARS=500
CLAUSE_REPAIR_ENABLED=true
CLAUSE_REPAIR_MIN_WORDS=350
# Clause repair is best-effort. A timeout preserves the deterministic clause unchanged.
CLAUSE_REPAIR_TIMEOUT_SEC=25
LLM_TIMEOUT_SEC=30
LLM_MAX_IN_FLIGHT_PER_KEY=1
LLM_MAX_RETRIES=1
# 0 uses every currently available NVIDIA key for the one final-report race.
FINAL_REPORT_RACE_KEYS=0
LLM_COOLDOWN_SEC=5
EMBEDDING_MODEL=nvidia/nv-embed-v1
FALLBACK_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64
EMBEDDING_BATCH_MAX_CHARS=120000

# Deployment-safe defaults for small free instances
DEBUG_TRACEFLOW=false
FORCE_LOCAL_EMBEDDINGS=false
RISK_ANALYZER_CONCURRENCY=2
EDGE_VERIFY_CONCURRENCY=2

# Local frontend development only
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
